# Copy to .env.sandbox (git-ignored): deploy/sandbox/setup.sh does it for you and fills SANDBOX_ROUTER_KEY. Secrets are files in deploy/compose/secrets.
KG_PUBLIC_HOST=sandbox.kg.example.com
KG_TLS=ops@example.com
KG_VERSION=p9
# the static site's exact https origin (CORS for the broker and the API)
SANDBOX_SITE_ORIGIN=https://kg.example.com
# the stand-in router: one random key shared by the platform and the mock router (setup.sh writes it)
SANDBOX_ROUTER_KEY=
# the router URL the prod compose requires; the sandbox overlay points the platform at the mock router instead
ROUTER_URL=http://mock-router:8781/v1
API_REPLICAS=2
NEO4J_HEAP=2g
NEO4J_PAGECACHE=2g
SANDBOX_TTL_HOURS=2
SANDBOX_POOL_SIZE=5
SANDBOX_MAX_ACTIVE=40
SANDBOX_IP_PER_HOUR=3
SANDBOX_REQUESTS_PER_MINUTE=120
SANDBOX_CONTEXT_PER_MINUTE=20
CORS_ALLOW_ORIGINS=[]
PAYLOAD_ACTIVE_KID=prod1
