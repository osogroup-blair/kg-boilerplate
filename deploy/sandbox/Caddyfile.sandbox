# The sandbox edge: one host, TLS, the broker under /sandbox, the API on an allowlist, the MCP server, and the admin console. Compare deploy/compose/Caddyfile.
# What is NOT reachable from outside, on purpose: /__mock (the mock router's control plane; it is on an internal network anyway), /metrics, /sandbox/metrics and the operations surface
# except two read-only calls the console's dashboard makes.
{
	admin off
}

http://127.0.0.1:8081 {
	bind 127.0.0.1
	respond /ready "ok" 200
}

{$KG_PUBLIC_HOST} {
	tls {$KG_TLS}
	encode zstd gzip

	header {
		-Server
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	# never published
	@never path /__mock* /metrics* /sandbox/metrics
	handle @never {
		respond 404
	}

	# the operations surface: only the two read-only calls the console's dashboard makes
	@ops_ok {
		method GET
		path /v1/operations/health /v1/operations/backlog
	}
	@ops path /v1/operations/*
	handle @ops_ok {
		reverse_proxy {
			dynamic a {
				name api
				port 8000
				refresh 10s
			}
		}
	}
	handle @ops {
		respond 404
	}

	@broker path /sandbox/*
	handle @broker {
		request_body {
			max_size 64KB
		}
		reverse_proxy broker:8020
	}

	@api path /v1/* /health
	handle @api {
		request_body {
			max_size 256KB
		}
		reverse_proxy {
			dynamic a {
				name api
				port 8000
				refresh 10s
			}
			lb_policy least_conn
			health_uri /health
			health_interval 5s
			health_timeout 3s
			transport http {
				dial_timeout 3s
				response_header_timeout 180s
			}
		}
	}

	handle /mcp* {
		reverse_proxy mcp:8010
	}

	handle {
		header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; object-src 'none'"
		header Cache-Control "no-cache"
		root * /srv
		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format json
	}
}
