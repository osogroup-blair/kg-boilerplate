# Copy to .env.prod (git-ignored) and fill in. Secrets are NOT here: they are files in deploy/compose/secrets (python scripts/prod_secrets.py).
KG_PUBLIC_HOST=kg.example.com
# the certificate contact e-mail (a public certificate via ACME), or `internal` for Caddy's own CA on a private name
KG_TLS=ops@example.com
ROUTER_URL=https://models.oso.group/v1
KG_VERSION=p9
API_REPLICAS=2
# graph memory: size to the VM (see docs/runbooks/deploy-production.md and the baseline report)
NEO4J_HEAP=2g
NEO4J_PAGECACHE=2g
PAYLOAD_ACTIVE_KID=prod1
# exact https origins only; empty = same-origin (the console is served by the same host, so it needs none)
CORS_ALLOW_ORIGINS=[]
AUTH_OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_CLIENT_ID=
OIDC_REDIRECT_URIS=["https://kg.example.com/login/callback"]
# break-glass: a human API key works in production only while this is true (each use is audited)
ALLOW_BREAKGLASS_KEYS=false
CANARY_WORKSPACE=
