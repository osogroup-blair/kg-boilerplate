{
 "title": "Knowledge platform: operations",
 "uid": "kg-ops",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "tags": [
  "kg"
 ],
 "templating": {
  "list": [
   {
    "name": "DS_PROMETHEUS",
    "type": "datasource",
    "query": "prometheus",
    "label": "Prometheus"
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Context builds / min by status",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (status) (rate(context_builds_total[5m])) * 60",
     "legendFormat": "{{status}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Context build time p50 / p95 by profile (s)",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.5, sum by (le, profile) (rate(context_build_duration_seconds_bucket[5m])))",
     "legendFormat": "p50 {{profile}}",
     "refId": "A"
    },
    {
     "expr": "histogram_quantile(0.95, sum by (le, profile) (rate(context_build_duration_seconds_bucket[5m])))",
     "legendFormat": "p95 {{profile}}",
     "refId": "B"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Outbox backlog by stage",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (stage) (outbox_backlog{status=\"pending\"})",
     "legendFormat": "{{stage}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Oldest claimable job (s) and dead letters",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "max(outbox_oldest_pending_age_seconds)",
     "legendFormat": "oldest pending",
     "refId": "A"
    },
    {
     "expr": "sum(outbox_dead_letters)",
     "legendFormat": "dead letters",
     "refId": "B"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Model router calls / min by outcome",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (outcome) (rate(router_calls_total[5m])) * 60",
     "legendFormat": "{{outcome}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Router tokens / min",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (direction) (rate(router_tokens_total[5m])) * 60",
     "legendFormat": "{{direction}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "API p95 latency by route (s)",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum by (le, route) (rate(http_request_duration_seconds_bucket[5m])))",
     "legendFormat": "{{route}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "API errors / min (5xx) and quota refusals",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "x": 12,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(rate(http_requests_total{status=~\"5..\"}[5m])) * 60",
     "legendFormat": "5xx",
     "refId": "A"
    },
    {
     "expr": "sum by (quota) (rate(quota_exceeded_total[5m])) * 60",
     "legendFormat": "quota {{quota}}",
     "refId": "B"
    }
   ]
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Backup age (h) per store",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "x": 0,
    "y": 32,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "h"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "backup_age_seconds / 3600",
     "legendFormat": "{{store}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Reconcile drift by class",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "x": 12,
    "y": 32,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (drift_class) (reconcile_drift)",
     "legendFormat": "{{drift_class}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "Canary builds by outcome (15 m) and seconds since last success",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "x": 0,
    "y": 40,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (outcome) (increase(canary_builds_total[15m]))",
     "legendFormat": "{{outcome}}",
     "refId": "A"
    },
    {
     "expr": "time() - canary_last_success_unixtime",
     "legendFormat": "since last success (s)",
     "refId": "B"
    }
   ]
  },
  {
   "id": 12,
   "type": "timeseries",
   "title": "Safety counters: budget violations, deletion residuals, leak check",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "x": 12,
    "y": 40,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(increase(context_budget_violations_total[1h]))",
     "legendFormat": "budget violations (1 h)",
     "refId": "A"
    },
    {
     "expr": "sum(increase(deletion_residuals_total[1h]))",
     "legendFormat": "deletion residuals (1 h)",
     "refId": "B"
    },
    {
     "expr": "max(leakage_check_failed)",
     "legendFormat": "leak check failed",
     "refId": "C"
    }
   ]
  },
  {
   "id": 13,
   "type": "timeseries",
   "title": "Limiter decisions / min and errors",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "x": 0,
    "y": 48,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (outcome) (rate(limiter_decisions_total[5m])) * 60",
     "legendFormat": "{{outcome}}",
     "refId": "A"
    },
    {
     "expr": "sum(rate(limiter_errors_total[5m])) * 60",
     "legendFormat": "limiter errors",
     "refId": "B"
    }
   ]
  },
  {
   "id": 14,
   "type": "timeseries",
   "title": "Dependencies (1 = up) and invalidation listeners",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "x": 12,
    "y": 48,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "min by (dependency) (dependency_up)",
     "legendFormat": "{{dependency}}",
     "refId": "A"
    },
    {
     "expr": "min(invalidation_listener_up)",
     "legendFormat": "invalidation listener",
     "refId": "B"
    }
   ]
  }
 ]
}