  docs={[{href:"/docs/concepts/time/",label:"Time in the platform"},{href:"/docs/reference/api-recipes/",label:"The as_of recipe"}]}
  next={{href:"/see-it/permissions/",label:"See the permission lens"}}
>
  <TimeSlider client:load />
</PlaygroundPage>
