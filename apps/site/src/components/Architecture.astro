---
// The one diagram: how facts get in, where they live, what comes out. Boxes link to their concept pages.
const box = (x: number, y: number, w: number, h: number, title: string, sub: string, href: string, tone: string) => ({ x, y, w, h, title, sub, href, tone });
const boxes = [
  box(10, 20, 190, 70, "Systems of record", "HR, CRM, apps: commands", "/docs/concepts/commands-vs-extraction/", "a"),
  box(10, 150, 190, 70, "Conversations, documents", "events with an Idempotency-Key", "/docs/concepts/commands-vs-extraction/", "a"),
  box(270, 20, 210, 70, "Ledger (Postgres)", "authoritative, row-level security", "/docs/concepts/ledger-and-graph/", "b"),
  box(270, 150, 210, 70, "Model pipeline", "extract → unverified proposals", "/docs/concepts/commands-vs-extraction/", "c"),
  box(550, 20, 190, 70, "Graph (Neo4j + Graphiti)", "a projection you can rebuild", "/docs/concepts/ledger-and-graph/", "b"),
  box(550, 150, 190, 70, "Curated memory", "scopes, visibility, search", "/docs/concepts/curated-memory/", "b"),
  box(810, 85, 140, 80, "Context engine", "bounded · cited · filtered", "/docs/concepts/context-engine/", "d"),
];
const fills: Record<string, string> = { a: "var(--kg-surface)", b: "var(--kg-accent-soft)", c: "var(--kg-warn-soft)", d: "var(--kg-good-soft)" };
const arrows = [
  [200, 55, 270, 55], [200, 185, 270, 185], [480, 55, 550, 55], [480, 185, 550, 185], [375, 150, 375, 90], [740, 55, 810, 110], [740, 185, 810, 140],
];
---
<figure class="arch">
  <svg viewBox="0 0 960 330" aria-labelledby="arch-t arch-d">
    <title id="arch-t">How the platform works</title>
    <desc id="arch-d">Systems of record write commands into the Postgres ledger. Conversations and documents go through a model pipeline that produces unverified proposals. The ledger projects into a graph; memory is curated; the context engine reads both and hands bounded, cited, permission-filtered packages to agents. Governance spans everything.</desc>
    <defs><marker id="ah" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0L10 5L0 10z" fill="var(--kg-muted)"/></marker></defs>
    {arrows.map((a) => <line x1={a[0]} y1={a[1]} x2={a[2]} y2={a[3]} stroke="var(--kg-muted)" stroke-width="2" marker-end="url(#ah)" />)}
    {boxes.map((b) => (
      <a href={b.href}>
        <rect x={b.x} y={b.y} width={b.w} height={b.h} rx="12" fill={fills[b.tone]} stroke="var(--kg-border)" />
        <text x={b.x + 12} y={b.y + 28} font-size="15" font-weight="700" fill="var(--kg-text)">{b.title}</text>
        <text x={b.x + 12} y={b.y + 50} font-size="12" fill="var(--kg-muted)">{b.sub}</text>
      </a>
    ))}
    <text x="640" y="125" font-size="11" fill="var(--kg-muted)" text-anchor="middle">proposals become</text>
    <text x="640" y="139" font-size="11" fill="var(--kg-muted)" text-anchor="middle">facts and memories</text>
    <a href="/docs/concepts/governance/">
      <rect x="10" y="255" width="940" height="60" rx="12" fill="var(--kg-surface-2)" stroke="var(--kg-border)" stroke-dasharray="6 4" />
      <text x="26" y="280" font-size="15" font-weight="700" fill="var(--kg-text)">Governance and security, across everything</text>
      <text x="26" y="301" font-size="12.5" fill="var(--kg-muted)">workspace isolation · subject ACLs · corrections with impact preview · deletion with a receipt · legal holds · audit · revocation</text>
    </a>
  </svg>
  <figcaption class="muted">Agents read through the SDK or MCP and write back sourced findings. They hold only their own key.</figcaption>
</figure>
<style>
  .arch { margin: 0; }
  .arch svg { width: 100%; height: auto; display: block; }
  .arch a text, .arch a rect { transition: opacity .15s; }
  .arch a:hover rect { stroke: var(--kg-accent); stroke-width: 2; }
  .arch figcaption { font-size: .9rem; margin-top: .5rem; }
</style>
